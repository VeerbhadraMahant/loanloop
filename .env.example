# LoanLoop environment. Local dev: copy to gateway/.env. Production: set these per service in Railway / Vercel
# (see docs/DEPLOY.md). Values below are dev defaults or placeholders; never commit real values.

# ---------------------------------------------------------------- gateway (Railway service "gateway")
GNANI_SPEECH_API_KEY=
INYA_PLATFORM_API_KEY=
# Three different random tokens in production (the gateway refuses the dev defaults when PUBLIC_GATEWAY_URL is public).
# Generate: python -c "import secrets;print(secrets.token_urlsafe(32))"
GATEWAY_SHARED_SECRET=dev-shared-secret-change-me
DASHBOARD_TOKEN=dev-dashboard-token-change-me
PHONE_TOKEN=dev-phone-token-change-me
# Fernet key, generate ONCE and keep it (losing it makes encrypted loan/account numbers unreadable):
# python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
ENCRYPTION_KEY=REPLACE_WITH_FERNET_KEY
# Public https URL of the gateway in production (Railway domain); anything non-localhost turns on the dev-secret refusal.
PUBLIC_GATEWAY_URL=http://localhost:8000
# Railway: ${{Postgres.DATABASE_URL}} (postgres:// and postgresql:// are accepted and converted to the asyncpg driver)
DATABASE_URL=postgresql+asyncpg://loanloop:loanloop@localhost:55432/loanloop
# Railway: ${{Redis.REDIS_URL}}
REDIS_URL=redis://localhost:56379/0
SESSION_TTL_S=1800
# Cron-style jobs loop in seconds; 0 disables
JOBS_INTERVAL_S=3600
# Optional: override the i18n directory (the gateway image sets it up already; leave unset)
# I18N_DIR=

# ---------------------------------------------------------------- voice (Railway service "voice")
# Railway: http://gateway.railway.internal:8000
GATEWAY_URL=http://127.0.0.1:8000
# Same values as the gateway's GATEWAY_SHARED_SECRET and DASHBOARD_TOKEN
# GATEWAY_SHARED_SECRET=
# DASHBOARD_TOKEN=
# GNANI_SPEECH_API_KEY=
# sarvam (hosted, default in production) | ollama | gemini
LLM_PROVIDER=ollama
# Used when the primary provider fails: ollama | none
LLM_FALLBACK=
SARVAM_API_KEY=
SARVAM_MODEL=sarvam-105b-conversations
GEMINI_API_KEY=
# Railway: http://ollama.railway.internal:11434
OLLAMA_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3:8b
# false in production to skip the startup Ollama warm-up request
WARMUP=true
# Local dev only: NEVER set in production
# VOICE_DEV=1
# Comma list of extra Host headers the voice service accepts: the voice Railway domain (no scheme)
VOICE_ALLOWED_HOSTS=
# Comma list of allowed browser origins (leave empty in production: the browser talks to the Vercel proxy only)
VOICE_ALLOWED_ORIGINS=
# Shared secret the Vercel proxy sends as X-Voice-Edge-Token; the voice service refuses a public deploy without it.
# Same value as the Vercel env VOICE_EDGE_TOKEN. python -c "import secrets;print(secrets.token_urlsafe(32))"
VOICE_EDGE_TOKEN=

# ---------------------------------------------------------------- web (Vercel, root dir web/)
# GATEWAY_URL=https://<gateway>.up.railway.app
# DASHBOARD_TOKEN=  PHONE_TOKEN=
# WEB_BASIC_AUTH=user:password
# WEB_ALLOWED_ORIGINS=https://<vercel domain>
# VOICE_URL=https://<voice>.up.railway.app
# VOICE_EDGE_TOKEN=
# Never set WEB_AUTH_DISABLED. Leave NEXT_PUBLIC_VOICE_URL unset.
