# Server-only (never NEXT_PUBLIC_).
GATEWAY_URL=http://127.0.0.1:8000
# Optional outer gate: when set to user:pass, the whole app sits behind HTTP Basic auth in addition to the per-user sign-in.
# Leave empty to rely on the sign-in pages alone (sessions are the lock).
WEB_BASIC_AUTH=
# Extra allowed Origins for POSTs when not served on localhost/127.0.0.1:3000 (comma-separated).
WEB_ALLOWED_ORIGINS=
# Voice service, server-side only: the browser reaches it through the same-origin /vx proxy.
VOICE_URL=http://127.0.0.1:8100
# Must equal the voice service's VOICE_EDGE_TOKEN (required when the voice service is public).
VOICE_EDGE_TOKEN=
