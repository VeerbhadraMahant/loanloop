# Server-only (never NEXT_PUBLIC_). Values must match gateway/.env.
GATEWAY_URL=http://127.0.0.1:8000
DASHBOARD_TOKEN=dev-dashboard-token-change-me
PHONE_TOKEN=dev-phone-token-change-me
# Set user:pass whenever the app is reachable beyond localhost.
WEB_BASIC_AUTH=
# Localhost demo only: allow access with WEB_BASIC_AUTH unset.
WEB_AUTH_DISABLED=1
# NEVER set WEB_AUTH_DISABLED in production (Vercel/Railway): it removes the login in front of paid voice credits and tier-2 approvals.
# Extra allowed Origins for approval POSTs when not served on localhost/127.0.0.1:3000 (comma-separated).
WEB_ALLOWED_ORIGINS=
# Voice service, server-side only: the browser reaches it through the same-origin /vx proxy.
VOICE_URL=http://127.0.0.1:8100
# Must equal the voice service's VOICE_EDGE_TOKEN (required when the voice service is public).
VOICE_EDGE_TOKEN=
# Leave unset to use /vx (the proxy). Setting it makes the browser call the voice service directly.
# NEXT_PUBLIC_VOICE_URL=
