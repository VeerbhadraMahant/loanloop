{
  "_comment": "LoanLoop custom actions. ${...} are env placeholders the operator fills in the console. Console-only: Agent Builder docs show no API for creating actions; see docs/agent-builder-setup.md. {{conversation_id}} availability is NOT IN DOCS (verify). Empty speak_during_action = leave the field blank.",
  "integration": {
    "name": "loanloop_gateway",
    "method": "POST",
    "base_url": "${PUBLIC_GATEWAY_URL}",
    "auth_header": {
      "key": "X-Gateway-Secret",
      "value": "${GATEWAY_SHARED_SECRET}"
    }
  },
  "actions": [
    {
      "name": "start_call",
      "description": "Trigger once at the very start of every call, before anything else. Creates the call session.",
      "method": "POST",
      "url": "${PUBLIC_GATEWAY_URL}/actions/start_call",
      "headers": {
        "X-Gateway-Secret": "${GATEWAY_SHARED_SECRET}",
        "Content-Type": "application/json"
      },
      "body": {
        "call_id": "{{conversation_id}}",
        "language": "{{language}}",
        "caller_number": "{{caller_number}}"
      },
      "variables": [
        {
          "name": "call_id",
          "type": "string",
          "description": "Always {{conversation_id}}",
          "required": true
        },
        {
          "name": "language",
          "type": "string",
          "description": "Caller's CURRENT language",
          "required": true,
          "enum": [
            "en",
            "hi",
            "hinglish",
            "mr"
          ]
        },
        {
          "name": "caller_number",
          "type": "string",
          "description": "Caller's phone number if the platform provides it; omit otherwise. Never treat as proof of identity.",
          "required": false
        }
      ],
      "speak_during_action": {
        "en": "One moment, checking that for you.",
        "hi": "एक क्षण, जाँच हो रही है।",
        "hinglish": "Ek minute, check ho raha hai.",
        "mr": "एक क्षण, तपासणी सुरू आहे."
      },
      "timeout_s": 5,
      "trigger": "On-Call"
    },
    {
      "name": "verify_caller",
      "description": "Trigger when the caller has given their registered mobile number AND either date of birth or last 4 digits of the loan number. Never trigger with only one of them.",
      "method": "POST",
      "url": "${PUBLIC_GATEWAY_URL}/actions/verify_caller",
      "headers": {
        "X-Gateway-Secret": "${GATEWAY_SHARED_SECRET}",
        "Content-Type": "application/json"
      },
      "body": {
        "call_id": "{{conversation_id}}",
        "language": "{{language}}",
        "registered_mobile": "{{registered_mobile}}",
        "dob": "{{dob}}",
        "loan_last4": "{{loan_last4}}"
      },
      "variables": [
        {
          "name": "call_id",
          "type": "string",
          "description": "Always {{conversation_id}}",
          "required": true
        },
        {
          "name": "language",
          "type": "string",
          "description": "Caller's CURRENT language",
          "required": true,
          "enum": [
            "en",
            "hi",
            "hinglish",
            "mr"
          ]
        },
        {
          "name": "registered_mobile",
          "type": "string",
          "description": "10-digit registered mobile number as spoken, digits only",
          "required": true
        },
        {
          "name": "dob",
          "type": "string",
          "description": "Date of birth as YYYY-MM-DD; omit if verifying by loan_last4",
          "required": false
        },
        {
          "name": "loan_last4",
          "type": "string",
          "description": "Last 4 digits of the loan number; omit if verifying by dob",
          "required": false
        }
      ],
      "speak_during_action": {
        "en": "One moment, checking that for you.",
        "hi": "एक क्षण, जाँच हो रही है।",
        "hinglish": "Ek minute, check ho raha hai.",
        "mr": "एक क्षण, तपासणी सुरू आहे."
      },
      "timeout_s": 5,
      "trigger": "On-Call"
    },
    {
      "name": "request_app_approval",
      "description": "Trigger when the caller needs a Tier 2 step (payments, EMI explanation, foreclosure, any change) and is verified (Tier 1) but not yet approved. Sends an approval request to the caller's banking app.",
      "method": "POST",
      "url": "${PUBLIC_GATEWAY_URL}/actions/request_app_approval",
      "headers": {
        "X-Gateway-Secret": "${GATEWAY_SHARED_SECRET}",
        "Content-Type": "application/json"
      },
      "body": {
        "call_id": "{{conversation_id}}",
        "language": "{{language}}",
        "purpose": "{{purpose}}"
      },
      "variables": [
        {
          "name": "call_id",
          "type": "string",
          "description": "Always {{conversation_id}}",
          "required": true
        },
        {
          "name": "language",
          "type": "string",
          "description": "Caller's CURRENT language",
          "required": true,
          "enum": [
            "en",
            "hi",
            "hinglish",
            "mr"
          ]
        },
        {
          "name": "purpose",
          "type": "string",
          "description": "Short reason, e.g. emi_date_change, payment_check, foreclosure, document, nominee, address, emi_explanation",
          "required": true
        }
      ],
      "speak_during_action": {
        "en": "One moment, sending the request to your app.",
        "hi": "एक क्षण, आपके ऐप पर अनुरोध भेजा जा रहा है।",
        "hinglish": "Ek minute, aapke app par request bheji ja rahi hai.",
        "mr": "एक क्षण, तुमच्या ॲपवर विनंती पाठवली जात आहे."
      },
      "timeout_s": 5,
      "trigger": "On-Call"
    },
    {
      "name": "check_approval",
      "description": "Trigger after the caller says they tapped Approve in the app (or after asking them to). Checks whether the approval is done.",
      "method": "POST",
      "url": "${PUBLIC_GATEWAY_URL}/actions/check_approval",
      "headers": {
        "X-Gateway-Secret": "${GATEWAY_SHARED_SECRET}",
        "Content-Type": "application/json"
      },
      "body": {
        "call_id": "{{conversation_id}}",
        "language": "{{language}}",
        "approval_id": "{{approval_id}}"
      },
      "variables": [
        {
          "name": "call_id",
          "type": "string",
          "description": "Always {{conversation_id}}",
          "required": true
        },
        {
          "name": "language",
          "type": "string",
          "description": "Caller's CURRENT language",
          "required": true,
          "enum": [
            "en",
            "hi",
            "hinglish",
            "mr"
          ]
        },
        {
          "name": "approval_id",
          "type": "string",
          "description": "approval_id returned by request_app_approval in data.approval_id",
          "required": true
        }
      ],
      "speak_during_action": {
        "en": "One moment, checking that for you.",
        "hi": "एक क्षण, जाँच हो रही है।",
        "hinglish": "Ek minute, check ho raha hai.",
        "mr": "एक क्षण, तपासणी सुरू आहे."
      },
      "timeout_s": 5,
      "trigger": "On-Call"
    },
    {
      "name": "branch_lookup",
      "description": "Trigger when the caller asks for a branch's IFSC, MICR, address or hours by branch name or city.",
      "method": "POST",
      "url": "${PUBLIC_GATEWAY_URL}/actions/branch_lookup",
