      "speak_during_action": {
        "en": "One moment, checking that for you.",
        "hi": "एक क्षण, जाँच हो रही है।",
        "hinglish": "Ek minute, check ho raha hai.",
        "mr": "एक क्षण, तपासणी सुरू आहे."
      },
      "timeout_s": 5,
      "trigger": "On-Call"
    },
