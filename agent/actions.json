      "speak_during_action": {
        "en": "One moment, checking that for you.",
        "hi": "एक क्षण, जाँच हो रही है।",
        "hinglish": "Ek minute, check ho raha hai.",
        "mr": "एक क्षण, तपासणी सुरू आहे."
      },
      "timeout_s": 5,
      "trigger": "On-Call"
    },
    {
      "name": "validate_ifsc",
      "description": "Trigger when the caller wants to check whether an IFSC code is correct.",
      "method": "POST",
      "url": "${PUBLIC_GATEWAY_URL}/actions/validate_ifsc",
      "headers": {
        "X-Gateway-Secret": "${GATEWAY_SHARED_SECRET}",
        "Content-Type": "application/json"
      },
      "body": {
        "call_id": "{{conversation_id}}",
        "language": "{{language}}",
        "ifsc": "{{ifsc}}"
      },
      "variables": [
        {
          "name": "call_id",
          "type": "string",
          "description": "Always {{conversation_id}}",
          "required": true
        },
        {
          "name": "language",
          "type": "string",
          "description": "Caller's CURRENT language",
          "required": true,
          "enum": [
            "en",
            "hi",
            "hinglish",
            "mr"
          ]
        },
        {
          "name": "ifsc",
          "type": "string",
          "description": "IFSC as 11 characters, uppercase, no spaces (letters and digits), e.g. SAHY0000123",
          "required": true
        }
      ],
      "speak_during_action": {
        "en": "One moment, checking that for you.",
        "hi": "एक क्षण, जाँच हो रही है।",
        "hinglish": "Ek minute, check ho raha hai.",
        "mr": "एक क्षण, तपासणी सुरू आहे."
      },
      "timeout_s": 5,
      "trigger": "On-Call"
    },
    {
