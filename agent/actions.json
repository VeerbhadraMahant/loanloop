      },
      "body": {
        "call_id": "{{conversation_id}}",
        "language": "{{language}}",
        "fields": "{{fields}}"
      },
      "variables": [
        {
          "name": "call_id",
          "type": "string",
          "description": "Always {{conversation_id}}",
          "required": true
        },
        {
          "name": "language",
          "type": "string",
          "description": "Caller's CURRENT language",
          "required": true,
          "enum": [
            "en",
            "hi",
            "hinglish",
            "mr"
          ]
