        "X-Gateway-Secret": "${GATEWAY_SHARED_SECRET}",
        "Content-Type": "application/json"
      },
      "body": {
        "call_id": "{{conversation_id}}",
        "language": "{{language}}",
        "query": "{{query}}"
      },
      "variables": [
        {
          "name": "call_id",
          "type": "string",
          "description": "Always {{conversation_id}}",
          "required": true
        },
        {
          "name": "language",
          "type": "string",
          "description": "Caller's CURRENT language",
          "required": true,
          "enum": [
            "en",
            "hi",
            "hinglish",
            "mr"
          ]
        },
        {
          "name": "query",
          "type": "string",
          "description": "Branch name or city as the caller said it",
          "required": true
        }
