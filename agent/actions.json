      "url": "${PUBLIC_GATEWAY_URL}/actions/get_masked_profile",
      "headers": {
        "X-Gateway-Secret": "${GATEWAY_SHARED_SECRET}",
        "Content-Type": "application/json"
      },
      "body": {
        "call_id": "{{conversation_id}}",
        "language": "{{language}}",
        "fields": "{{fields}}"
      },
      "variables": [
        {
          "name": "call_id",
          "type": "string",
          "description": "Always {{conversation_id}}",
          "required": true
        },
        {
          "name": "language",
          "type": "string",
          "description": "Caller's CURRENT language",
          "required": true,
          "enum": [
            "en",
            "hi",
            "hinglish",
            "mr"
          ]
        },
        {
          "name": "fields",
          "type": "array<string>",
          "description": "Any of: account_number, ifsc, customer_id, mobile, email, branch",
          "required": true
